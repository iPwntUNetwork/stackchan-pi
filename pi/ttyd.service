[Unit]
Description=ttyd terminal server (Stack-chan on-device shell)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# --writable lets the robot's on-screen keyboard type into the shell.
# -c user:pass protects it; the firmware's pi_token field takes "user:pass".
ExecStart=/usr/bin/ttyd --writable -p 7681 -c pi:stackchan /bin/bash -l
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
